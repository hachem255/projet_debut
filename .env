# ── Smart Library — Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.
# The server reads .env automatically on startup (no extra library needed).

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────────
LIBRARY_DB_PATH=library_search.db

# ── Email verification (for self-registration via signup.html) ───────────────
# Create a Gmail App Password at: https://myaccount.google.com/apppasswords
# Leave empty to disable public self-registration (admin-created accounts still work).
GMAIL_EMAIL=hachemdahmani41@gmail.com
GMAIL_APP_PASSWORD=kouk scio vhne awxx
VERIFICATION_TTL_MINUTES=10

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SEC=60

# ── PDF uploads ───────────────────────────────────────────────────────────────
PDF_UPLOAD_DIR=uploads/pdfs
PDF_MAX_FILE_MB=50
